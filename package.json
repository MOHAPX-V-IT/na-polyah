{
  "name": "na-polyah",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -k \"npm:api\" \"npm:preview\"",
    "dev": "concurrently -k \"npm:api\" \"npm:ui\"",
    "api": "node server/index.mjs",
    "ui": "vite --host 127.0.0.1 --port 4314 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4314 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "lib0": "^0.2.114",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "y-codemirror.next": "^0.3.5",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
